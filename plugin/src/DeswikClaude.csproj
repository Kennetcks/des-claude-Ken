<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>Kennet.DeswikClaude</RootNamespace>
    <AssemblyName>Kennet.DeswikClaude</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <!-- Change this if Deswik is installed somewhere else -->
    <DeswikDir>C:\Program Files\Deswik\Deswik.Suite 2024.2</DeswikDir>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(DeswikDir)\Newtonsoft.Json.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Deswik.Graphics"><HintPath>$(DeswikDir)\Deswik.Graphics.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Deswik.Common.Utilities"><HintPath>$(DeswikDir)\Deswik.Common.Utilities.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Deswik.Common.Core"><HintPath>$(DeswikDir)\Deswik.Common.Core.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Deswik.Common.Plugins.Host"><HintPath>$(DeswikDir)\Deswik.Common.Plugins.Host.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Deswik.InteractiveScheduler"><HintPath>$(DeswikDir)\Deswik.InteractiveScheduler.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Deswik.Scheduler.Engine"><HintPath>$(DeswikDir)\Deswik.Scheduler.Engine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Deswik.Scheduler.API"><HintPath>$(DeswikDir)\Deswik.Scheduler.API.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Deswik.Geometry"><HintPath>$(DeswikDir)\Deswik.Geometry.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Deswik.Scheduler.API.Contracts"><HintPath>$(DeswikDir)\Deswik.Scheduler.API.Contracts.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ClaudeChatPlugin.cs" />
    <Compile Include="ChatPanel.cs" />
    <Compile Include="ClaudeAgent.cs" />
    <Compile Include="DeswikTools.cs" />
    <Compile Include="CodeRunner.cs" />
    <Compile Include="ApprovalDialog.cs" />
    <Compile Include="PluginSettings.cs" />
    <Compile Include="SystemPrompt.cs" />
    <Compile Include="McpPipeServer.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
